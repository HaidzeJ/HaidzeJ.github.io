---
/*
  Site header. On wide screens it becomes a sticky left column (name, role,
  section nav, social links) while the content scrolls on the right.
  On phones it's a normal header at the top.
*/
const links = [
  // Root-relative ("/#about") so the links also work from the 404 page.
  { href: '/#about', label: 'About' },
  { href: '/#changelog', label: 'Changelog' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div>
    <h1 class="name"><a href="/">Jeremiah Haidze</a></h1>
    <p class="role">Front-end developer</p>
    <p class="tagline">I build fast, accessible websites and web apps.</p>

    <nav aria-label="Sections">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}><span class="line" aria-hidden="true"></span>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <ul class="social">
    <li><a href="https://github.com/HaidzeJ">GitHub</a></li>
    <li><a href="https://www.linkedin.com/in/jhaidze">LinkedIn</a></li>
  </ul>
</header>

<script>
  /*
    Scroll spy: marks the nav link for the section currently on screen.
    IntersectionObserver tells us when a section crosses the middle band of
    the viewport, without checking the scroll position on every scroll event.
  */
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-header nav a')];

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of navLinks) {
          const isCurrent = link.hash === `#${entry.target.id}`;
          // aria-current tells screen readers which link matches what's on screen.
          if (isCurrent) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      }
    },
    // Only the band from 40% to 60% of the viewport height counts.
    { rootMargin: '-40% 0px -60% 0px' },
  );

  for (const link of navLinks) {
    const section = document.querySelector(link.hash);
    if (section) observer.observe(section);
  }
</script>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
  }

  .name {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .role {
    margin: var(--space-3) 0 0;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .tagline {
    margin: var(--space-2) 0 0;
    max-width: 30ch;
    color: var(--color-muted);
  }

  nav {
    display: none;
  }

  nav ul,
  .social {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Nav link with a line in front of it. The line grows on hover and on the
     current section (inspired by brittanychiang.com). */
  nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .line {
    width: 2rem;
    height: 1px;
    background: currentColor;
    transition:
      width 200ms ease,
      background-color 200ms ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current] {
    color: var(--color-text);
  }

  nav a:hover .line,
  nav a:focus-visible .line,
  nav a[aria-current] .line {
    width: 4rem;
    height: 2px;
    background: var(--color-accent);
  }

  .social {
    display: flex;
    gap: var(--space-4);
  }

  .social a {
    color: var(--color-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .social a:hover {
    color: var(--color-accent);
  }

  /* Wide screens: sticky full-height left column, nav visible. */
  @media (min-width: 64rem) {
    .site-header {
      position: sticky;
      top: 0;
      height: 100vh;
      padding-block: var(--space-7);
    }

    nav {
      display: block;
      margin-top: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line {
      transition: none;
    }
  }
</style>
