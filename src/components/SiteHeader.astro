---
/*
  Site header. On wide screens it becomes a sticky left column (name, role,
  section nav, social links) while the content scrolls on the right.
  On phones it's a normal header at the top.
*/
import { profile } from '../data/profile';

const links = [
  // Root-relative ("/#about") so the links also work from the 404 page.
  { href: '/#about', label: 'About' },
  { href: '/#changelog', label: 'Changelog' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div>
    <h1 class="name"><a href="/">{profile.name}</a></h1>
    <p class="role">{profile.role}</p>
    <p class="tagline">I build fast, accessible websites and web apps.</p>

    <nav aria-label="Sections">
      <ul>
        {links.map((link) => (
          <li><a href={link.href}><span class="line" aria-hidden="true"></span>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <ul class="social">
    <li><a href={profile.github}>GitHub</a></li>
    <li><a href={profile.linkedin}>LinkedIn</a></li>
  </ul>
</header>

<script>
  /*
    Scroll spy: marks the nav link for the section currently on screen.
    The current section is the last one whose top has scrolled past a line
    200px down the viewport. The line has to sit above the Changelog heading
    after the About link jumps to About (256px apart at the narrowest), or
    clicking About would light up Changelog. About starts above the line and
    Contact (short, at the very bottom) can never reach it, so two edge
    cases: nothing past the line yet = the first section, and scrolled to
    the bottom of the page = the last section.
  */
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-header nav a')];
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section) => section !== null);

  function updateCurrent() {
    const line = 200;
    const atBottom =
      window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;

    let current = sections[0];
    if (atBottom) {
      current = sections[sections.length - 1];
    } else {
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) current = section;
      }
    }

    for (const link of navLinks) {
      // aria-current tells screen readers which link matches what's on screen.
      if (link.hash === `#${current?.id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }

  // Scroll events fire many times per frame; requestAnimationFrame runs the
  // check at most once per frame so scrolling stays smooth.
  let queued = false;
  function queueUpdate() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      updateCurrent();
    });
  }

  window.addEventListener('scroll', queueUpdate, { passive: true });
  window.addEventListener('resize', queueUpdate);
  updateCurrent();
</script>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-5);
  }

  .name {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .role {
    margin: var(--space-3) 0 0;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .tagline {
    margin: var(--space-2) 0 0;
    max-width: 30ch;
    color: var(--color-muted);
  }

  nav {
    display: none;
  }

  nav ul,
  .social {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Nav link with a line in front of it. The line grows on hover and on the
     current section (inspired by brittanychiang.com). */
  nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .line {
    width: 2rem;
    height: 1px;
    background: currentColor;
    transition:
      width 200ms ease,
      background-color 200ms ease;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a[aria-current] {
    color: var(--color-text);
  }

  nav a:hover .line,
  nav a:focus-visible .line,
  nav a[aria-current] .line {
    width: 4rem;
    height: 2px;
    background: var(--color-accent);
  }

  .social {
    display: flex;
    gap: var(--space-4);
  }

  .social a {
    color: var(--color-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .social a:hover {
    color: var(--color-accent);
  }

  /* Wide screens: sticky full-height left column, nav visible. */
  @media (min-width: 64rem) {
    .site-header {
      position: sticky;
      top: 0;
      height: 100vh;
      padding-block: var(--space-7);
    }

    nav {
      display: block;
      margin-top: var(--space-6);
    }
  }
</style>
