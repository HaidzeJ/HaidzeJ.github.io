---
/* Footer doubles as the contact section (the nav's "Contact" link). */
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="container">
    <h2>Contact</h2>
    <ul class="links">
      <li><a href="https://github.com/HaidzeJ">GitHub</a></li>
      <li><a href="https://www.linkedin.com/in/jhaidze">LinkedIn</a></li>
      <li><a href="https://github.com/HaidzeJ/HaidzeJ.github.io">Source for this site</a></li>
    </ul>
    <p class="copyright">© {year} Jeremiah Haidze</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  h2 {
    margin-top: 0;
    font-size: var(--text-lg);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .copyright {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
