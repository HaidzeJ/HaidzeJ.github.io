---
/*
  One changelog entry. Uses a description list (<dl>) because each part is a
  label/value pair: Shipped, Stack, My role, Notes.
*/
import type { Release } from '../data/releases';

interface Props {
  release: Release;
}

const { version, title, dates, shipped, stack, role, notes } = Astro.props.release;
---

<article class="release">
  <header>
    <h3>
      <span class="version">{version}</span>
      <span class="title">{title}</span>
    </h3>
    <p class="dates">{dates}</p>
  </header>

  <dl>
    <dt>Shipped</dt>
    <dd>
      <ul>{shipped.map((item) => <li>{item}</li>)}</ul>
    </dd>

    <dt>Stack</dt>
    <dd>
      <ul class="stack">{stack.map((tool) => <li>{tool}</li>)}</ul>
    </dd>

    <dt>My role</dt>
    <dd>{role}</dd>

    {notes && (
      <>
        <dt>Notes</dt>
        <dd>
          <ul>{notes.map((note) => <li>{note}</li>)}</ul>
        </dd>
      </>
    )}
  </dl>
</article>

<style>
  .release {
    position: relative;
    padding-left: var(--space-4);
  }

  /* The timeline dot, centered on the vertical line drawn by the parent list. */
  .release::before {
    content: '';
    position: absolute;
    left: calc(-0.375rem - 1px);
    top: 0.55rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
  }

  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-size: var(--text-lg);
  }

  /* Version tag styled like a git tag: monospace, accent color. */
  .version {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    border-radius: var(--radius);
  }

  .dates {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  dl {
    margin: var(--space-3) 0 0;
  }

  dt {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  dd ul {
    margin: 0;
    padding-left: 1.2em;
  }

  /* Stack shown as small inline chips instead of bullets.
     "dd .stack" so it outranks the "dd ul" padding rule above. */
  dd .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.1em 0.6em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
</style>
