---
/*
  One changelog entry, in one of two shapes:
  - featured: a card with an image (or placeholder), summary, stack chips,
    and a "Details" toggle for Shipped / My role / Notes.
  - compact: a single row (version, title, dates) that expands on click.
  Both use <details>, which opens and closes without any JavaScript and
  works with the keyboard and screen readers out of the box.
*/
import { Image } from 'astro:assets';
import type { Release } from '../data/releases';

interface Props {
  release: Release;
}

const { version, title, dates, summary, stack, featured, images, placeholder, link, shipped, role, notes } =
  Astro.props.release;

const hasDetails = Boolean(shipped || role || notes);
---

{featured ? (
  <article class="release featured">
    {images && (
      <div class:list={['media', { grid: images.length > 1 }]}>
        {images.map((image) => (
          <Image
            src={image.src}
            alt={image.alt}
            widths={images.length > 1 ? [400, 640] : [640, 960, 1280]}
            sizes={images.length > 1 ? '(min-width: 64rem) 20rem, 50vw' : '(min-width: 64rem) 40rem, 100vw'}
          />
        ))}
      </div>
    )}
    {!images && placeholder && (
      <div class="media placeholder" aria-hidden="true">
        <span>{placeholder}</span>
      </div>
    )}

    <header>
      <h3>
        <span class="version">{version}</span>
        <span class="title">{title}</span>
      </h3>
      <p class="dates">{dates}</p>
    </header>

    <p class="summary">{summary}</p>
    <ul class="stack" aria-label="Stack">{stack.map((tool) => <li>{tool}</li>)}</ul>
    {link && <a class="out-link" href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>}

    {hasDetails && (
      <details>
        <summary>Details</summary>
        <dl>
          {shipped && (
            <>
              <dt>Shipped</dt>
              <dd><ul>{shipped.map((item) => <li>{item}</li>)}</ul></dd>
            </>
          )}
          {role && (
            <>
              <dt>My role</dt>
              <dd>{role}</dd>
            </>
          )}
          {notes && (
            <>
              <dt>Notes</dt>
              <dd><ul>{notes.map((note) => <li>{note}</li>)}</ul></dd>
            </>
          )}
        </dl>
      </details>
    )}
  </article>
) : (
  <details class="release compact">
    <summary>
      <span class="version">{version}</span>
      <span class="title">{title}</span>
      <span class="dates">{dates}</span>
    </summary>
    <div class="compact-body">
      <p class="summary">{summary}</p>
      <ul class="stack" aria-label="Stack">{stack.map((tool) => <li>{tool}</li>)}</ul>
      {link && <a class="out-link" href={link.href}>{link.label}<span aria-hidden="true"> ↗</span></a>}
      {(role || notes) && (
        <dl>
          {role && (
            <>
              <dt>My role</dt>
              <dd>{role}</dd>
            </>
          )}
          {notes && (
            <>
              <dt>Notes</dt>
              <dd><ul>{notes.map((note) => <li>{note}</li>)}</ul></dd>
            </>
          )}
        </dl>
      )}
    </div>
  </details>
)}

<style>
  .release {
    position: relative;
    margin-left: var(--space-4);
    border: 1px solid transparent;
    border-radius: calc(var(--radius) * 2);
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  /* The timeline dot, centered on the vertical line drawn by the parent list. */
  .release::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4) - 0.375rem - 2px);
    top: 1.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    transition:
      background-color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  /* Hover (and keyboard focus inside) lifts the card and lights its dot. */
  .release:hover,
  .release:focus-within {
    background: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: var(--shadow);
  }

  .release:hover::before,
  .release:focus-within::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 6px var(--color-glow);
    transform: scale(1.15);
  }

  .featured {
    padding: var(--space-3);
  }

  /* ---------- Media ---------- */
  .media {
    overflow: hidden;
    margin-bottom: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    aspect-ratio: 16 / 10;
  }

  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 400ms ease;
  }

  .release:hover .media img {
    transform: scale(1.03);
  }

  .media.grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--color-border);
  }

  /* Placeholder: a striped box with a monospace label. */
  .placeholder {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 12px,
        var(--color-glow) 12px 24px
      ),
      var(--color-surface);
  }

  .placeholder span {
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  /* ---------- Heading ---------- */
  h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-size: var(--text-lg);
  }

  /* Version tag styled like a git tag. It fills in on hover. */
  .version {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    padding: 0.1em 0.5em;
    border: 1px solid currentColor;
    border-radius: var(--radius);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .release:hover .version,
  .release:focus-within .version {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .dates {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .summary {
    margin: var(--space-2) 0 0;
  }

  /* ---------- Stack chips ---------- */
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.15em 0.75em;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-glow);
    border-radius: 999px;
  }

  /* Outbound link (e.g. Credly). The arrow nudges up-right on hover. */
  .out-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .out-link:hover {
    text-decoration: underline;
  }

  .out-link span {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .out-link:hover span {
    transform: translate(2px, -2px);
  }

  /* ---------- Details toggle ---------- */
  details summary {
    cursor: pointer;
    list-style: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  .featured details {
    margin-top: var(--space-3);
  }

  .featured summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
  }

  .featured summary:hover {
    color: var(--color-text);
  }

  /* A chevron drawn with borders; it rotates when the toggle opens. */
  .featured summary::after,
  .compact summary::after {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-25%);
    transition: transform 200ms ease;
  }

  details[open] > summary::after {
    transform: rotate(-135deg) translateY(-25%);
  }

  dl {
    margin: var(--space-2) 0 0;
  }

  dt {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  dd {
    margin: var(--space-1) 0 0;
  }

  dd ul {
    margin: 0;
    padding-left: 1.2em;
  }

  /* ---------- Compact rows ---------- */
  .compact::before {
    top: 1.05rem;
    width: 0.6rem;
    height: 0.6rem;
    left: calc(-1 * var(--space-4) - 0.3rem - 2px);
  }

  .compact summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) var(--space-3);
  }

  .compact .title {
    font-weight: 600;
  }

  .compact .dates {
    margin: 0 0 0 auto;
  }

  .compact summary::after {
    color: var(--color-muted);
  }

  .compact-body {
    padding: 0 var(--space-3) var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .release,
    .release::before,
    .media img,
    .version,
    .out-link span,
    summary::after {
      transition: none;
    }

    .release:hover .media img {
      transform: none;
    }
  }
</style>
