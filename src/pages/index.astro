---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReleaseEntry from '../components/ReleaseEntry.astro';
import { releases } from '../data/releases';
---

<BaseLayout
  title="Jeremiah Haidze · Front-end developer"
  description="Front-end developer with hands-on experience in Shopify, Liquid and Vue. My work history, written as a changelog."
>
  <section class="about" id="about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="visually-hidden">About</h2>
    <p>
      I’ve spent most of my career building and shipping e-commerce sites: more than five
      years at Lull, from campaign landing pages to a full Shopify migration, then a Vue
      contract at RYZE Superfoods.
    </p>
    <p class="hint">
      Below is my work history, written as a changelog. Each role or project is a release.
    </p>
  </section>

  <section id="changelog" aria-labelledby="changelog-heading">
    <h2 id="changelog-heading">Changelog</h2>
    <ol class="timeline">
      {releases.map((release) => (
        <li><ReleaseEntry release={release} /></li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .about {
    font-size: var(--text-lg);
  }

  .about p {
    margin-top: 0;
  }

  .hint {
    color: var(--color-muted);
    font-size: var(--text-base);
  }

  h2 {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* The vertical timeline line. Each release draws its own dot on it. */
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--color-border);
  }

  /* The glowing segment that follows the mouse along the line.
     Spotlight.astro sets --glow-y and adds .is-scrubbing while the mouse
     is anywhere to the right of the line. */
  .timeline::after {
    content: '';
    position: absolute;
    left: -2px;
    top: calc(var(--glow-y, 0px) - 80px);
    width: 2px;
    height: 160px;
    background: linear-gradient(transparent, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .timeline.is-scrubbing::after {
    opacity: 1;
  }

  /* While one entry is hovered, fade the others so it stands out.
     :has() lets the list react to the state of one of its children. */
  .timeline > li {
    transition: opacity 200ms ease;
  }

  .timeline:has(> li:hover) > li:not(:hover) {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::after,
    .timeline > li {
      transition: none;
    }
  }
</style>
