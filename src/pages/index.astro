---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReleaseEntry from '../components/ReleaseEntry.astro';
import { releases } from '../data/releases';
---

<BaseLayout
  title="Jeremiah Haidze · Front-end developer"
  description="Front-end developer who builds fast, accessible websites and web apps. My work history, written as a changelog."
>
  <section class="about" id="about" aria-labelledby="about-heading">
    <h2 id="about-heading" class="visually-hidden">About</h2>
    <p>
      I’ve been shipping production websites for more than five years. At Lull, that meant
      everything from campaign landing pages to a full Shopify migration. Most recently, I
      refactored a Vue customer portal for RYZE Superfoods. I care about pages that load fast, work for everyone, and are easy for
      the next developer to change.
    </p>
  </section>

  <section id="changelog" aria-labelledby="changelog-heading">
    <h2 id="changelog-heading" class="section-label">Changelog</h2>
    <ol class="timeline">
      {releases.map((release) => (
        <li><ReleaseEntry release={release} /></li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  /* A step above body text, but on phones no bigger than the changelog
     card titles (18px), so the headings still lead. */
  .about {
    font-size: var(--text-md);
  }

  @media (min-width: 40rem) {
    .about {
      font-size: var(--text-lg);
    }
  }

  /* About 60 characters per line, inside the 45-75 range that reads best. */
  .about p {
    max-width: 60ch;
    margin: 0;
  }

  #changelog-heading {
    margin: var(--section-gap) 0 0;
  }

  /* The vertical timeline line. Each release draws its own dot on it. */
  .timeline {
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--color-border);
  }

  /* The glowing segment that follows the mouse along the line.
     Spotlight.astro sets --glow-y and adds .is-scrubbing while the mouse
     is anywhere to the right of the line. */
  .timeline::after {
    content: '';
    position: absolute;
    left: -2px;
    top: calc(var(--glow-y, 0px) - 80px);
    width: 2px;
    height: 160px;
    background: linear-gradient(transparent, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .timeline.is-scrubbing::after {
    opacity: 1;
  }

  /* While one entry is hovered, fade the others so it stands out.
     :has() lets the list react to the state of one of its children.
     Mouse devices only: on a phone a tap counts as hover and sticks, which
     left the rest of the list dimmed while scrolling. */
  .timeline > li {
    transition: opacity 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .timeline:has(> li:hover) > li:not(:hover) {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::after,
    .timeline > li {
      transition: none;
    }
  }
</style>
